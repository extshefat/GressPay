# Coolify WEB service only (Next.js). Secrets do not belong here.
# Google / DB / R2 / JWT → backend/.env.example (PHP API service)

NEXT_PUBLIC_DATA_SOURCE=live
NEXT_PUBLIC_API_URL=
GRESSPAY_PHP_URL=http://gresspay-api:8080

# Super Admin Allowlist (configured on backend PHP service; documented here for convenience)
# ADMIN_EMAIL=owner@example.com
