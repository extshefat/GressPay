# Dependencies & build (reinstall with npm ci / npm install)
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# Secrets — keep only .env.example
.env
.env.local
.env.*.local
backend/.env

# Local PHP SQLite / logs
backend/storage/*.sqlite
backend/storage/*.sqlite-*
backend/storage/*.log
*.log

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
.cursor/
*.swp

.android-sdk/

# Android companion (GressPay-App-Project) — never commit build outputs or keystores
GressPay-App-Project/**/build/
GressPay-App-Project/.gradle/
GressPay-App-Project/local.properties
GressPay-App-Project/*.iml
GressPay-App-Project/**/*.jks
GressPay-App-Project/**/*.keystore
# Ship APKs only via public/download/ or CI artifacts — not app/build outputs
GressPay-App-Project/**/*.apk
GressPay-App-Project/**/*.aab
