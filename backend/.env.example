# Coolify PHP API service only — not the Next.js web .env
# Merchant wallets / Binance merchant secrets / QR files → dashboard (MySQL + R2), not here.

APP_NAME=GressPay
APP_ENV=production
PUBLIC_APP_URL=https://gresspay.extxcheats.com
APP_URL=https://gresspay.extxcheats.com
ADMIN_EMAIL=
ADMIN_EMAILS=

# Auth / encryption (required in production, ≥32 chars each)
JWT_SECRET=
APP_ENCRYPTION_KEY=

# --- Super Admin Email Allowlist (single or comma-separated) ---
# Merchants matching these emails automatically receive role=admin and plan_id=enterprise.
ADMIN_EMAIL=
ADMIN_EMAILS=

CORS_ORIGINS=https://your-domain.com

# --- Database (MySQL on Coolify) ---
DB_DRIVER=mysql
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=gresspay
DB_DATABASE=gresspay
DB_USER=gresspay
DB_USERNAME=gresspay
DB_PASS=
DB_PASSWORD=
# Optional full URL style note: host/port/name/user/pass above are what the app reads
# (there is no separate DATABASE_URL variable in code).

# Local/dev only (do not use SQLite in Coolify production)
# DB_DRIVER=sqlite
# SQLITE_PATH=storage/gresspay.sqlite

# --- Google Sign-In (API only; web .env needs nothing for Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gresspay.extxcheats.com/callback/google

# --- Operator crypto gate ---
GRESSPAY_CRYPTO_ALLOWED=0

# --- Binance Pay (platform API base only; merchant keys = dashboard) ---
BINANCE_PAY_API_BASE=https://bpay.binanceapi.com

# --- Tron / USDT (platform; merchant receive address = dashboard) ---
TRON_API_BASE=https://api.trongrid.io
TRON_API_KEY=
USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_CONFIRMATIONS=20

# --- Webhooks ---
WEBHOOK_TIMEOUT_SECONDS=8
WEBHOOK_MAX_RETRIES=5

# --- Cloudflare R2 (private bucket for merchant QR images) ---
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PRESIGN_TTL_SECONDS=300
R2_MAX_UPLOAD_BYTES=5242880
R2_PUBLIC_BASE_URL=
